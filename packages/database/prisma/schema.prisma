generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// Placeholder row for tooling; replace with real domain models as the product grows.
model IvyMeta {
  id        Int    @id @default(1)
  schemaTag String @default("v0")
}

model User {
  id          String   @id @default(cuid())
  clerkUserId String   @unique
  email       String?
  firstName   String?
  lastName    String?
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  posts           FeedPost[]
  postLikes       FeedPostLike[]
  postComments    FeedPostComment[]
  episodeComments EpisodeComment[]
  hubMemberships  HubMembership[]
  hubMessages     HubMessage[]
}

model FeedPost {
  id        String   @id @default(cuid())
  authorId  String
  body      String   @db.Text
  createdAt DateTime @default(now())

  author   User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  likes    FeedPostLike[]
  comments FeedPostComment[]

  @@index([createdAt])
}

model FeedPostLike {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
}

model FeedPostComment {
  id        String   @id @default(cuid())
  postId    String
  authorId  String
  body      String   @db.Text
  createdAt DateTime @default(now())

  post   FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([createdAt])
}

/// Flat discussion thread anchored to a YouTube video. The "thread" itself is implicit —
/// it's simply the set of EpisodeComment rows sharing a `youtubeVideoId`. No parent record
/// is created until the first comment, which keeps us from pre-seeding for every playlist item.
model EpisodeComment {
  id             String   @id @default(cuid())
  youtubeVideoId String
  authorId       String
  body           String   @db.Text
  createdAt      DateTime @default(now())

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([youtubeVideoId, createdAt])
  @@index([authorId])
}

/// SOAR Hubs — small groups housed under "The Nest". Canonical hubs (Entrepreneurs,
/// College Life, Golden Age, Ahh Man) are seeded via `prisma/seed.ts` and identified by
/// a stable `slug`. Each hub has memberships and a public chat between members.
model Hub {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  tagline     String?
  description String?  @db.Text
  icon        String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships HubMembership[]
  messages    HubMessage[]

  @@index([sortOrder])
}

model HubMembership {
  id                    String   @id @default(cuid())
  hubId                 String
  userId                String
  notificationsEnabled  Boolean  @default(false)
  joinedAt              DateTime @default(now())

  hub  Hub  @relation(fields: [hubId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([hubId, userId])
  @@index([userId])
}

model HubMessage {
  id        String   @id @default(cuid())
  hubId     String
  authorId  String
  body      String   @db.Text
  createdAt DateTime @default(now())

  hub    Hub  @relation(fields: [hubId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([hubId, createdAt])
  @@index([authorId])
}

/// Scheduled Monday Mentorship Moment live streams (monthly live event + weekly drops).
/// `startsAt` is the scheduled start time. `durationMinutes` defines the live window so the
/// app can decide whether to show a countdown or the live embed.
model LiveEvent {
  id              String   @id @default(cuid())
  title           String
  description     String?  @db.Text
  youtubeVideoId  String
  startsAt        DateTime
  durationMinutes Int      @default(60)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([startsAt])
}
