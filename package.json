{
  "name": "ivy",
  "private": true,
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "clean": "turbo run clean && rm -rf node_modules",
    "postinstall": "DATABASE_URL=\"mysql://user:pass@127.0.0.1:3306/ivy\" turbo run build --filter=@ivy/api"
  },
  "devDependencies": {
    "prettier": "^3.1.1",
    "turbo": "^2.8.0"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "react": "19.1.0",
    "react-dom": "19.1.0"
  }
}
