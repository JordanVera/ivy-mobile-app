# MySQL connection string for Prisma (used by @ivy/web API routes and packages/database).
DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/ivy"

# YouTube Data API v3 key (https://console.cloud.google.com/apis/credentials). Used by tRPC `youtube.playlistVideos`.
YOUTUBE_API_KEY=""

# Optional. Defaults to the #MMM playlist if unset.
# YOUTUBE_PLAYLIST_ID="PL3L7uqjW75F4AXIHPq2xrm7o9NHmTquXr"
