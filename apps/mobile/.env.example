# Copy to `.env` for local development. Expo loads `EXPO_PUBLIC_*` at build time.
# Example: a public YouTube video or past live VOD used as the Watch tab placeholder.
EXPO_PUBLIC_YOUTUBE_PLACEHOLDER_VIDEO_ID=dQw4w9WgXcQ

# Base URL of the Next.js app (tRPC). Use your machine LAN IP when testing on a physical device.
EXPO_PUBLIC_API_URL=http://localhost:3000
